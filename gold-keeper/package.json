{
  "name": "gold-keeper",
  "version": "1.0.0",
  "description": "梦幻西游金币管家 - 基于 Cloudflare Pages + D1 的金币记录工具",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=./.wrangler/state/d1/gold-keeper-db.sqlite3",
    "deploy": "wrangler pages deploy public",
    "init-db": "wrangler d1 execute gold-keeper-db --file=./schema.sql"
  },
  "dependencies": {
    "@cloudflare/wrangler": "^3.0.0"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "keywords": [
    "cloudflare-pages",
    "cloudflare-d1",
    "dream-fantasy",
    "gold-tracker"
  ],
  "license": "MIT"
}
