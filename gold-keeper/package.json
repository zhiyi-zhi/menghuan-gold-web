{
  "name": "gold-keeper",
  "version": "1.0.0",
  "description": "梦幻西游金币管家 — Cloudflare Pages + D1",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=gold-keeper-db",
    "db:create": "wrangler d1 create gold-keeper-db",
    "db:init": "wrangler d1 execute gold-keeper-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute gold-keeper-db --local --file=./schema.sql",
    "deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^3.45.0"
  }
}
